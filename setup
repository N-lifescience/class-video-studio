#!/bin/zsh
# 처음 한 번: ./setup
#   파이썬 환경, ffmpeg, 얼굴 찾기 모델까지 설치한다. 받아쓰기 모델은 처음 받아쓸 때 내려받는다.
# 필요한 것: Homebrew
set -e
cd "${0:A:h}"

command -v brew >/dev/null || { echo "Homebrew 가 필요해요: https://brew.sh 에서 설치한 뒤 다시 ./setup 을 돌려 주세요."; exit 1; }

for pkg in python@3.12 ffmpeg; do
  brew list --versions $pkg >/dev/null 2>&1 || { echo "설치: $pkg"; brew install $pkg; }
done

PY="$(brew --prefix python@3.12)/bin/python3.12"
[[ -d .venv ]] || "$PY" -m venv .venv
echo "파이썬 패키지 설치 중…"
.venv/bin/pip install -q --upgrade pip
.venv/bin/pip install -q -r requirements.txt

.venv/bin/python tools/cvs.py doctor --fetch-model

cat <<'MSG'

준비 끝.
  Claude Code(또는 Claude 데스크톱 앱의 Code 탭)나 Codex 에서 이 폴더를 열고
  「수업발표대회에 낼 수업 영상 편집해 줘」라고 말해 보세요.
MSG
